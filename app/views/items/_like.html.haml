%div#like-buttons.container.likes.text-end
  %div.btn-group.shadow-0{role: "group"}
    - if user_signed_in?
      - if item.liked_by?(current_user)
        = button_to item_like_path(item, item.likes.find_by(user: current_user)), method: :delete, id: "like-button", class:"btn btn-link", "data-mdb-ripple-color": "dark" do
          %i.fas.fa-heart
          = item.like_count
      - else
        = button_to item_likes_path(item), id: "like-button", class:"btn btn-link" do
          %i.far.fa-heart
          = item.like_count
    - else
      %i.fas.fa-heart
      %span= item.like_count


    %a.like-count.btn.btn-link{tabindex: "0",
      role: "button",
      data: {controller: "popover"},
      "data-mdb-toggle": "popover",
      title: t("views.items._content.liked_person"),
      "data-mdb-placement": "bottom",
      "data-mdb-trigger": "focus",
      "data-mdb-content": (item.liked_users.map{|user|html_escape(user.name)}.join("<br/>") + " ")
    }
      %i.fa.fa-user

