- content_for(:content) do
  %div.container.mt-4
    %h1= t('boards.edit.title')
    %hr

    = render 'form', board: @board

    - if @board.editable?(current_user)
      %hr
      = link_to t('board_memberships.index.title'), board_board_memberships_path(@board.board_id), class: 'btn btn-outline-secondary mb-3'

    - if @board.deletable?(current_user)
      %hr
      %h4= t('boards.edit.danger_zone')
      %div.card.border-danger.mt-3
        %div.card-body
          %h5.card-title.text-danger= t('boards.edit.delete_board')
          %p= t('boards.edit.confirm_delete', board_id: @board.board_id)
          = form_with url: board_path(@board.board_id), method: :delete,
                      html: { data: { controller: 'board-delete-confirmation',
                                      'board-delete-confirmation-expected-id-value': @board.board_id,
                                      'turbo-confirm': t('boards.edit.delete_warning') } } do
            = label_tag :confirm_board_id, t('boards.edit.confirm_board_id_label'), class: 'form-label'
            = text_field_tag :confirm_board_id, nil, class: 'form-control mb-2',
                             data: { 'board-delete-confirmation-target': 'input',
                                     action: 'input->board-delete-confirmation#check' }
            = button_tag t('boards.edit.delete_board'), type: 'submit',
                         class: 'btn btn-danger',
                         data: { 'board-delete-confirmation-target': 'submit' }
